# DO NOT put real credentials in this file if it's ever committed to GitHub.
# This file just shows the structure. Real secrets go into Streamlit Cloud's
# "Secrets" settings panel (App -> Settings -> Secrets), which is private
# and separate from your public repo.
#
# For local testing only, you may copy this to .streamlit/secrets.toml
# (already gitignored) and fill in real values there.

EMAIL_ADDRESS = "your-gmail-address@gmail.com"
EMAIL_APP_PASSWORD = "your-16-character-gmail-app-password"
# Optional overrides (defaults shown):
# SMTP_SERVER = "smtp.gmail.com"
# SMTP_PORT = 587

# Employee portal persistent storage (Supabase). See README ->
# "Employee portal setup" for the SQL to run and where to get these values.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "your-anon-public-api-key"

# Data Processor's AI-powered file interpretation. See README ->
# "Data processor setup" for where to get this key.
ANTHROPIC_API_KEY = "sk-ant-your-api-key-here"

